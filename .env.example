# Local single-container dev config. Copy this to `.env` and run `docker compose up`.
#   cp .env.example .env
# Nothing below needs editing for a standard local run.

# --- Postgres (runs inside the same container) ---
POSTGRES_USER=vexagent
POSTGRES_PASSWORD=vexagent
POSTGRES_DB=vexagent
DATABASE_URL=postgresql://vexagent:vexagent@127.0.0.1:5432/vexagent

# --- LLM: Ollama running natively on your Mac ---
# One time on the host (not in Docker):
#   brew install ollama
#   ollama pull gpt-oss-20b
#   ollama serve        # (the Ollama.app does this automatically)
OPENAI_BASE_URL=http://host.docker.internal:11434/v1
OPENAI_API_KEY=ollama            # value is ignored by Ollama, but one must be set
NAVIGATOR_MODEL=gpt-oss-20b
LLM_ENABLE_THINKING=false

# --- Client / CORS ---
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Local safety: keep this box OFF production infrastructure ---
# The proactive daemon messages REAL students. Never on for local dev.
TRIGGER_DAEMON_ENABLED=false
# No Invite Hub sync locally (leave these blank). The seeded fixtures give you real
# VEX telemetry to work against without ever touching production data.
INVITE_HUB_BASE_URL=
INVITE_HUB_USERNAME=
INVITE_HUB_PASSWORD=

# Even if you add Hub credentials above, do NOT drain the whole Hub history on the
# startup path -- against a fresh database that starves the API and resets connections.
# Left off so the app comes up instantly; pull real logs deliberately when you want
# them (runs off the request path, so it never blocks the app):
#   docker compose exec app vex-fetch-logs --incremental --insert
INVITE_HUB_SYNC_ON_BOOT=false

# Cloudflare Turnstile bot-gate on /v1/*. Off locally so the API works with zero
# Cloudflare setup and fully offline. It defaults to ON everywhere else, so prod
# behavior is unchanged. SESSION_SECRET only matters when the gate is enabled.
TURNSTILE_ENABLED=false
SESSION_SECRET=local-dev-not-a-secret
